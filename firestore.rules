rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'cndescortezadoranquil.pehuen@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.matches('.*admin.*@.*'))
      );
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc(request.auth.uid).data.role == 'Administrador'
      );
    }

    function isSupervisorOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          getUserDoc(request.auth.uid).data.role == 'Supervisor' ||
          getUserDoc(request.auth.uid).data.role == 'Administrador'
        )
      );
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isSupervisorOrAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Collection: personal (Forestry staff/operators)
    // Only Supervisor & Admin can edit, add, delete. Signed-in can read to populate operator dropdowns.
    match /personal/{personalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSupervisorOrAdmin();
    }

    // Collection: produccion_dia
    // All roles can create & read. Only Supervisor & Admin can edit or delete.
    match /produccion_dia/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSupervisorOrAdmin();
    }

    // Collection: produccion_personal
    // All roles can create & read. Only Supervisor & Admin can edit or delete.
    match /produccion_personal/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSupervisorOrAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
