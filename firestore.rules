rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Collection: users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collection: personal (Forestry staff/operators)
    match /personal/{personalId} {
      allow read, write: if true;
    }

    // Collection: produccion_dia
    match /produccion_dia/{docId} {
      allow read, write: if true;
    }

    // Collection: produccion_personal
    match /produccion_personal/{docId} {
      allow read, write: if true;
    }

    // App config settings (e.g. meta mensual faena)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
